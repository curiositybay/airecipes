{
  "name": "airecipes",
  "version": "1.0.0",
  "description": "Portfolio demonstration: AI-powered recipe generation with 100% test coverage, CI/CD automation, and modern web development practices",
  "private": true,
  "keywords": [
    "ai",
    "recipes",
    "openai",
    "nextjs",
    "typescript",
    "cooking",
    "food",
    "ingredients",
    "portfolio",
    "cicd",
    "testing",
    "docker",
    "devops",
    "fullstack"
  ],
  "author": "Curiosity Bay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/curiositybay/airecipes.git"
  },
  "homepage": "https://github.com/curiositybay/airecipes#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:seed": "node scripts/setup-db.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write . && npm run lint",
    "docker:build": "./scripts/build-docker.sh",
    "docker:build:push": "./scripts/build-docker.sh --push",
    "docker:build:multi": "./scripts/build-docker.sh --platform linux/amd64,linux/arm64",
    "docker:size": "docker images curiositybay/test:latest --format 'table {{.Repository}}\t{{.Tag}}\t{{.Size}}'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.1",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/redis": "^4.0.10",
    "axios": "^1.13.2",
    "jiti": "^2.6.1",
    "next": "^16.1.1",
    "openai": "^5.23.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "redis": "^5.10.0",
    "sweetalert2": "^11.26.17",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yargs-parser": "^21.0.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-mock-axios": "^4.9.0",
    "jest-mock-extended": "^4.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "prisma": "^6.19.1",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
